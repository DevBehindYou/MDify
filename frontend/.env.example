# Copy to .env.local for local development.
# On Vercel, set these as Project Environment Variables.

# URL of the running MDify Pro FastAPI backend (used at build time for the
# Next.js proxy rewrites and exposed to the browser for the cold-start ping).
# Local:  http://localhost:8000
# Prod:   https://mdify-pro-api.onrender.com
BACKEND_URL=http://localhost:8000

# Public canonical site origin (used for SEO metadata / canonical URLs).
# Prod: https://mdify-pro.vercel.app  (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
