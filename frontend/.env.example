# Server-only settings for the Next.js frontend. Never prefix these with
# NEXT_PUBLIC_ — that would ship them to the browser bundle.

# Normal pool (backendN) instances, comma-separated: N1,N2
NORMAL_BACKEND_URLS=http://localhost:8001

# OCR pool (backendO) instances, comma-separated: O1,O2
OCR_BACKEND_URLS=http://localhost:8002

# Archive pool (backendZ) instances for ZIP files, comma-separated: Z1,Z2.
# Unset = ZIP files are refused. Without Supabase (below), images inside a
# ZIP are listed but their text is not recognised.
ARCHIVE_BACKEND_URLS=http://localhost:8005

# Shared secret sent as X-Internal-Secret; must match INTERNAL_SHARED_SECRET
# on every backend instance. Generate with: openssl rand -hex 32
BACKEND_SHARED_SECRET=change-me

# Supabase (server-only). When set, uploads go straight from the browser to
# Supabase Storage and job state lives in Postgres; when unset, the app uses
# the multipart /api/convert path (local development).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=mdify-pro-files

# Background jobs (Supabase mode). Supabase Cron POSTs /api/jobs/tick every
# minute with this value in the x-mdify-cron-secret header (supabase/cron.sql).
# Unset = the tick route is disabled; jobs still advance while the user's
# browser waits. Generate with: openssl rand -hex 32
# CRON_SECRET=

# Optional tuning (defaults shown)
# MAX_INFLIGHT_NORMAL=4        # items running at once on the normal pool
# MAX_INFLIGHT_OCR=            # default: one per OCR instance
# MAX_INFLIGHT_ARCHIVE=        # default: one per archive instance
# STORAGE_BUDGET_BYTES=838860800  # new uploads wait above ~800 MB in Storage

# Admin controller (/mdify-controller). Both keys are needed to sign in; each
# at least 24 characters and different from the other. Unset = the controller
# stays closed. Changing either key signs every admin out.
# Generate each with: openssl rand -hex 32
# ADMIN_KEY_1=
# ADMIN_KEY_2=
