{
  "name": "mdify-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-blog-index.mjs",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "prebuild": "node scripts/build-blog-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.mjs\"",
    "blog:index": "node scripts/build-blog-index.mjs",
    "blog:check": "node scripts/build-blog-index.mjs --check",
    "sql:setup": "node scripts/build-setup-sql.mjs",
    "sql:check": "node scripts/build-setup-sql.mjs --check",
    "brand:images": "node scripts/build-brand-images.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "^14.2.35",
    "prismjs": "^1.30.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6"
  }
}
