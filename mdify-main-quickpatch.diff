+import { csvToMarkdown, jsonToMarkdown } from './text.js';
+import { htmlFileToMarkdown } from './html.js';
+import { pdfToMarkdown } from './pdf.js';
+import { docxToMarkdown } from './docx.js';
+import { spreadsheetToMarkdown } from './spreadsheet.js';
+import { pptxToMarkdown } from './pptx.js';
+import { epubToMarkdown } from './epub.js';
+import { imageToMarkdown } from './image.js';
+
+export const SUPPORTED_EXTENSIONS = [
+  'txt', 'md', 'markdown',
+  'csv', 'json', 'xml',
+  'html', 'htm',
+  'pdf', 'docx', 'xlsx', 'xls', 'pptx', 'epub',
+  'jpg', 'jpeg', 'png',
+];
+
+export class UnsupportedFormatError extends Error {
+  constructor(ext) {
+    super(`Unsupported file format: .${ext}`);
+    this.name = 'UnsupportedFormatError';
+  }
+}
+
+function titleFromStem(stem) {
+  return stem.replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
+}
+
+/**
+ * Converts one uploaded file to Markdown using real, format-specific
+ * extraction — no fabricated content for any format.
+ *
+ * @returns {Promise<{ markdown: string, warning: string|null }>}
+ */
+export async function convertToMarkdown({ buffer, originalName, ext, stem }) {
+  const title = titleFromStem(stem);
+
+  switch (ext) {
+    case 'txt':
+    case 'md':
+    case 'markdown':
+      return { markdown: buffer.toString('utf-8'), warning: null };
+
+    case 'csv':
+      return { markdown: csvToMarkdown(buffer.toString('utf-8'), title), warning: null };
+
+    case 'json':
+      return { markdown: jsonToMarkdown(buffer.toString('utf-8'), title), warning: null };
+
+    case 'xml':
+      return {
+        markdown: `# ${title}\n\n\`\`\`xml\n${buffer.toString('utf-8')}\n\`\`\`\n`,
+        warning: null,
+      };
+
+    case 'html':
+    case 'htm':
+      return { markdown: htmlFileToMarkdown(buffer.toString('utf-8'), title), warning: null };
+
+    case 'pdf':
+      return pdfToMarkdown(buffer, title);
+
+    case 'docx':
+      return docxToMarkdown(buffer, title);
+
+    case 'xlsx':
+    case 'xls':
+      return spreadsheetToMarkdown(buffer, title);
+
+    case 'pptx':
+      return pptxToMarkdown(buffer, title);
+
+    case 'epub':
+      return epubToMarkdown(buffer, title);
+
+    case 'jpg':
+    case 'jpeg':
+    case 'png':
+      return imageToMarkdown(buffer, title, originalName, buffer.length);
+
+    default:
+      throw new UnsupportedFormatError(ext);
+  }
+}
diff --git a/lib/converters/pdf.js b/lib/converters/pdf.js
new file mode 100644
index 0000000..1e4a855
--- /dev/null
+++ b/lib/converters/pdf.js
@@ -0,0 +1,34 @@
+import { PDFParse } from 'pdf-parse';
+
+// Below this many extracted characters per page, a PDF is almost certainly
+// scanned/image-based rather than genuinely empty — MDify has no OCR yet,
+// so we say so instead of returning near-nothing with no explanation.
+const MIN_CHARS_PER_PAGE = 20;
+
+export async function pdfToMarkdown(buffer, title) {
+  const parser = new PDFParse({ data: buffer });
+  try {
+    const result = await parser.getText();
+    const pageCount = result.pages?.length || 1;
+    const text = (result.text || '')
+      .replace(/^--\s*\d+\s*of\s*\d+\s*--$/gm, '')
+      .replace(/\n{3,}/g, '\n\n')
+      .trim();
+
+    if (text.length < MIN_CHARS_PER_PAGE * pageCount) {
+      return {
+        markdown:
+          `# ${title}\n\n` +
+          `> ⚠️ **Little or no extractable text found.** This PDF is likely scanned or image-based ` +
+          `(${pageCount} page${pageCount === 1 ? '' : 's'}). MDify doesn't run OCR yet, so only the text ` +
+          `layer — if any — was extracted:\n\n` +
+          (text ? '```\n' + text + '\n```\n' : '_No text layer present._\n'),
+        warning: 'low-text-pdf',
+      };
+    }
+
+    return { markdown: `# ${title}\n\n${text}\n`, warning: null };
+  } finally {
+    await parser.destroy?.();
+  }
+}
diff --git a/lib/converters/pptx.js b/lib/converters/pptx.js
new file mode 100644
index 0000000..055cc3f
--- /dev/null
+++ b/lib/converters/pptx.js
@@ -0,0 +1,43 @@
+import JSZip from 'jszip';
+
+const SLIDE_RE = /^ppt\/slides\/slide(\d+)\.xml$/;
+
+function decodeXmlEntities(str) {
+  return str
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&apos;/g, "'")
+    .replace(/&amp;/g, '&');
+}
+
+/** Pulls visible text runs (<a:t>) out of one slide's XML, in document order. */
+function extractSlideText(xml) {
+  const runs = [...xml.matchAll(/<a:t>([^<]*)<\/a:t>/g)].map((m) => decodeXmlEntities(m[1]));
+  return runs.join(' ').replace(/\s+/g, ' ').trim();
+}
+
+export async function pptxToMarkdown(buffer, title) {
+  const zip = await JSZip.loadAsync(buffer);
+
+  const slideEntries = Object.keys(zip.files)
+    .map((name) => {
+      const match = name.match(SLIDE_RE);
+      return match ? { name, index: Number(match[1]) } : null;
+    })
+    .filter(Boolean)
+    .sort((a, b) => a.index - b.index); // numeric, not "slide10" before "slide2"
+
+  if (slideEntries.length === 0) {
+    return { markdown: `# ${title}\n\n_No slides found in this file._\n`, warning: 'no-slides' };
+  }
+
+  const slides = [];
+  for (const entry of slideEntries) {
+    const xml = await zip.files[entry.name].async('string');
+    const text = extractSlideText(xml);
+    slides.push(`## Slide ${entry.index}\n\n${text || '_(no text on this slide)_'}`);
+  }
+
+  return { markdown: `# ${title}\n\n${slides.join('\n\n')}\n`, warning: null };
+}
diff --git a/lib/converters/spreadsheet.js b/lib/converters/spreadsheet.js
new file mode 100644
index 0000000..67c5f90
--- /dev/null
+++ b/lib/converters/spreadsheet.js
@@ -0,0 +1,32 @@
+import * as XLSX from 'xlsx';
+
+function rowsToMarkdownTable(rows) {
+  if (rows.length === 0) return '_Empty sheet._';
+  const maxCols = Math.max(...rows.map((r) => r.length), 1);
+  const pad = (r) => {
+    const copy = [...r];
+    while (copy.length < maxCols) copy.push('');
+    return copy.map((c) => String(c ?? '').replace(/\|/g, '\\|'));
+  };
+
+  const header = pad(rows[0]);
+  const separator = header.map(() => '---');
+  const body = rows.slice(1).map((r) => `| ${pad(r).join(' | ')} |`);
+
+  return [`| ${header.join(' | ')} |`, `| ${separator.join(' | ')} |`, ...body].join('\n');
+}
+
+export function spreadsheetToMarkdown(buffer, title) {
+  const workbook = XLSX.read(buffer, { type: 'buffer' });
+
+  if (workbook.SheetNames.length === 0) {
+    return { markdown: `# ${title}\n\n_This workbook has no sheets._\n`, warning: 'empty-workbook' };
+  }
+
+  const sections = workbook.SheetNames.map((name) => {
+    const rows = XLSX.utils.sheet_to_json(workbook.Sheets[name], { header: 1, defval: '' });
+    return `## ${name}\n\n${rowsToMarkdownTable(rows)}`;
+  });
+
+  return { markdown: `# ${title}\n\n${sections.join('\n\n')}\n`, warning: null };
+}
