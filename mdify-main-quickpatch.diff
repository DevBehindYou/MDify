@@ -0,0 +1,14 @@
+import { htmlToMarkdown } from './htmlToMarkdown.js';
+
+export function htmlFileToMarkdown(rawHtml, fallbackTitle) {
+  const titleMatch = rawHtml.match(/<title[^>]*>([^<]*)<\/title>/i);
+  const title = (titleMatch ? titleMatch[1] : fallbackTitle).trim() || fallbackTitle;
+
+  // Convert only the <body> when present so <head> metadata never leaks
+  // into the output as stray text.
+  const bodyMatch = rawHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i);
+  const scope = bodyMatch ? bodyMatch[1] : rawHtml;
+
+  const markdown = htmlToMarkdown(scope);
+  return `# ${title}\n\n${markdown}\n`;
+}
diff --git a/lib/converters/htmlToMarkdown.js b/lib/converters/htmlToMarkdown.js
new file mode 100644
index 0000000..44980e2
--- /dev/null
+++ b/lib/converters/htmlToMarkdown.js
@@ -0,0 +1,61 @@
+import TurndownService from 'turndown';
+import { gfm } from 'turndown-plugin-gfm';
+
+let _service = null;
+
+/**
+ * Shared Turndown instance. Turndown ships its own lightweight HTML parser,
+ * so this runs fine in a Node serverless function with no DOM/jsdom needed.
+ */
+function getService() {
+  if (_service) return _service;
+  _service = new TurndownService({
+    headingStyle: 'atx',
+    codeBlockStyle: 'fenced',
+    bulletListMarker: '-',
+  });
+  _service.use(gfm);
+  // Drop script/style content entirely instead of turning it into text noise.
+  _service.remove(['script', 'style', 'noscript']);
+  return _service;
+}
+
+/**
+ * turndown-plugin-gfm only recognizes a <table> as a table when its first
+ * row uses <th>. Mammoth (DOCX) and plenty of hand-written HTML use plain
+ * <td> for header rows, which makes the plugin silently fall back to
+ * passing the raw <table> HTML straight through. To get real Markdown pipe
+ * tables in those cases, promote the first row to <th> and unwrap any <p>
+ * tags inside cells (which otherwise inject stray blank lines mid-cell).
+ */
+function normalizeTablesForGfm(html) {
+  return html.replace(/<table[^>]*>([\s\S]*?)<\/table>/gi, (_match, inner) => {
+    let cleaned = inner.replace(/<\/?p[^>]*>/gi, '');
+    let promoted = false;
+    cleaned = cleaned.replace(/<tr[^>]*>([\s\S]*?)<\/tr>/i, (rowMatch, rowInner) => {
+      if (promoted) return rowMatch;
+      promoted = true;
+      const headerRow = rowInner
+        .replace(/<td(\s[^>]*)?>/gi, '<th$1>')
+        .replace(/<\/td>/gi, '</th>');
+      return `<tr>${headerRow}</tr>`;
+    });
+    return `<table>${cleaned}</table>`;
+  });
+}
+
+export function htmlToMarkdown(html) {
+  if (!html || !html.trim()) return '';
+  try {
+    return getService().turndown(normalizeTablesForGfm(html)).trim();
+  } catch (err) {
+    // Never let a malformed-HTML edge case take down the whole conversion —
+    // fall back to a crude tag strip so the user still gets *something*.
+    return html
+      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
+      .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '')
+      .replace(/<[^>]+>/g, ' ')
+      .replace(/\s+/g, ' ')
+      .trim();
+  }
+}
