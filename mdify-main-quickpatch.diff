+++ b/lib/converters/docx.js
@@ -0,0 +1,20 @@
+import mammoth from 'mammoth';
+import { htmlToMarkdown } from './htmlToMarkdown.js';
+
+export async function docxToMarkdown(buffer, title) {
+  const result = await mammoth.convertToHtml({ buffer });
+  const markdown = htmlToMarkdown(result.value);
+
+  const warnings = (result.messages || [])
+    .filter((m) => m.type === 'warning')
+    .map((m) => m.message);
+
+  if (!markdown) {
+    return {
+      markdown: `# ${title}\n\n_No extractable text found in this document._\n`,
+      warning: 'empty-docx',
+    };
+  }
+
+  return { markdown: `# ${title}\n\n${markdown}\n`, warning: warnings[0] || null };
+}
