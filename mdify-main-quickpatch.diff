index 0000000..e0f2d05
--- /dev/null
+++ b/lib/converters/text.js
@@ -0,0 +1,64 @@
+/**
+ * Minimal, dependency-free CSV parser good enough for previewing tabular
+ * data as a Markdown table. Only double quotes are treated as CSV quoting
+ * (the previous version also toggled on single quotes, which mangled any
+ * field containing an apostrophe, e.g. "O'Brien").
+ */
+function parseCsvRow(line) {
+  const row = [];
+  let inQuotes = false;
+  let current = '';
+  for (let i = 0; i < line.length; i++) {
+    const char = line[i];
+    if (char === '"') {
+      if (inQuotes && line[i + 1] === '"') {
+        // Escaped quote ("") inside a quoted field.
+        current += '"';
+        i++;
+      } else {
+        inQuotes = !inQuotes;
+      }
+    } else if (char === ',' && !inQuotes) {
+      row.push(current.trim());
+      current = '';
+    } else {
+      current += char;
+    }
+  }
+  row.push(current.trim());
+  return row;
+}
+
+export function csvToMarkdown(csvText, title) {
+  const lines = csvText.split(/\r?\n/).filter((l) => l.trim().length > 0);
+  if (lines.length === 0) return `# ${title}\n\n_Empty CSV file._\n`;
+
+  const rows = lines.map(parseCsvRow);
+  const maxCols = Math.max(...rows.map((r) => r.length));
+
+  const header = rows[0].map((c) => c || '-');
+  while (header.length < maxCols) header.push('-');
+  const separator = header.map(() => '---');
+
+  const body = rows
+    .slice(1)
+    .map((r) => {
+      const padded = [...r];
+      while (padded.length < maxCols) padded.push('');
+      return `| ${padded.join(' | ')} |`;
+    })
+    .join('\n');
+
+  return `# ${title}\n\n| ${header.join(' | ')} |\n| ${separator.join(' | ')} |\n${body}\n`;
+}
+
+export function jsonToMarkdown(rawText, title) {
+  try {
+    const parsed = JSON.parse(rawText);
+    return `# ${title}\n\n\`\`\`json\n${JSON.stringify(parsed, null, 2)}\n\`\`\`\n`;
+  } catch {
+    // Not valid JSON despite the extension — still return the raw content
+    // rather than silently pretending it parsed.
+    return `# ${title}\n\n> ⚠️ This file has a \`.json\` extension but is not valid JSON. Showing raw content.\n\n\`\`\`\n${rawText}\n\`\`\`\n`;
+  }
+}
