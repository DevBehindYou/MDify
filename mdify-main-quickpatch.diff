new file mode 100644
index 0000000..905e10f
--- /dev/null
+++ b/lib/converters/epub.js
@@ -0,0 +1,93 @@
+import JSZip from 'jszip';
+import { htmlToMarkdown } from './htmlToMarkdown.js';
+
+function dirname(path) {
+  const idx = path.lastIndexOf('/');
+  return idx === -1 ? '' : path.slice(0, idx);
+}
+
+function joinPath(dir, href) {
+  if (!dir) return href;
+  // EPUB hrefs are always relative; strip any "../" the naive way since
+  // manifest paths never legitimately escape the OPF's own directory.
+  return `${dir}/${href}`.replace(/\/\.\//g, '/');
+}
+
+/** Real reading order via container.xml -> OPF manifest + spine. */
+async function readSpineDocuments(zip) {
+  const containerXml = await zip.files['META-INF/container.xml']?.async('string');
+  if (!containerXml) return null;
+
+  const opfPathMatch = containerXml.match(/full-path="([^"]+)"/);
+  const opfPath = opfPathMatch?.[1];
+  const opfFile = opfPath && zip.files[opfPath];
+  if (!opfFile) return null;
+
+  const opfXml = await opfFile.async('string');
+  const opfDir = dirname(opfPath);
+
+  const manifest = {};
+  for (const m of opfXml.matchAll(/<item\b([^>]*)\/>/g)) {
+    const attrs = m[1];
+    const id = attrs.match(/\bid="([^"]+)"/)?.[1];
+    const href = attrs.match(/\bhref="([^"]+)"/)?.[1];
+    const properties = attrs.match(/\bproperties="([^"]+)"/)?.[1] || '';
+    if (id && href) manifest[id] = { href, isNav: properties.includes('nav') };
+  }
+
+  const spineIds = [...opfXml.matchAll(/<itemref\b([^>]*)\/>/g)]
+    .map((m) => m[1].match(/\bidref="([^"]+)"/)?.[1])
+    .filter(Boolean);
+
+  const titleMatch = opfXml.match(/<dc:title[^>]*>([^<]*)<\/dc:title>/i);
+
+  const docs = spineIds
+    .map((id) => manifest[id])
+    .filter((item) => item && !item.isNav) // skip the nav/TOC page itself
+    .map((item) => joinPath(opfDir, item.href));
+
+  return { docs, title: titleMatch?.[1]?.trim() };
+}
+
+/** Fallback when container.xml/OPF parsing fails: every (x)html file, name-sorted. */
+function fallbackDocuments(zip) {
+  return Object.keys(zip.files)
+    .filter((name) => /\.x?html?$/i.test(name) && !/nav\.x?html?$/i.test(name))
+    .sort();
+}
+
+export async function epubToMarkdown(buffer, title) {
+  const zip = await JSZip.loadAsync(buffer);
+
+  let docs;
+  let bookTitle = title;
+  let warning = null;
+
+  const spineResult = await readSpineDocuments(zip).catch(() => null);
+  if (spineResult && spineResult.docs.length > 0) {
+    docs = spineResult.docs;
+    bookTitle = spineResult.title || title;
+  } else {
+    docs = fallbackDocuments(zip);
+    warning = docs.length > 0 ? 'epub-fallback-order' : null;
+  }
+
+  if (docs.length === 0) {
+    return { markdown: `# ${bookTitle}\n\n_No readable chapters found in this EPUB._\n`, warning: 'no-chapters' };
+  }
+
+  const sections = [];
+  for (const path of docs) {
+    const file = zip.files[path];
+    if (!file) continue;
+    const xhtml = await file.async('string');
+    const md = htmlToMarkdown(xhtml);
+    if (md) sections.push(md);
+  }
+
+  const notice = warning === 'epub-fallback-order'
+    ? '> ⚠️ Chapter order below is alphabetical by filename — this EPUB\'s manifest/spine could not be read to determine true reading order.\n\n'
+    : '';
+
+  return { markdown: `# ${bookTitle}\n\n${notice}${sections.join('\n\n---\n\n')}\n`, warning };
+}
