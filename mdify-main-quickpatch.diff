+import { imageSize } from 'image-size';
+
+export function imageToMarkdown(buffer, title, originalName, sizeBytes) {
+  let dims = null;
+  try {
+    dims = imageSize(buffer);
+  } catch {
+    // Corrupt/truncated image or an unrecognized variant — fall through
+    // and report what we can rather than failing the whole request.
+  }
+
+  const rows = [
+    `| **Filename** | ${originalName} |`,
+    `| **File size** | ${(sizeBytes / 1024).toFixed(1)} KB |`,
+  ];
+  if (dims) {
+    rows.push(`| **Dimensions** | ${dims.width} × ${dims.height} px |`);
+    rows.push(`| **Format** | ${(dims.type || '').toUpperCase()} |`);
+  }
+
+  const markdown =
+    `# ${title}\n\n` +
+    `| Property | Value |\n| --- | --- |\n${rows.join('\n')}\n\n` +
+    `> **Note:** OCR isn't available yet, so image text isn't extracted — this is metadata only.\n`;
+
+  return { markdown, warning: 'image-metadata-only' };
+}
