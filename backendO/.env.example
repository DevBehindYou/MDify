# backendO — OCR pool. Deploy twice (O1, O2) from this folder's Dockerfile
# with the same image and a different BACKEND_INSTANCE.

BACKEND_ROLE=ocr
BACKEND_INSTANCE=O1

# Must equal BACKEND_SHARED_SECRET on the frontend. Without it every
# internal call is rejected (fail closed).
INTERNAL_SHARED_SECRET=change-me

# Optional OCR tuning (defaults shown)
# OCR_MAX_PIXELS=25000000
# OCR_MAX_SIDE=10000
# OCR_LANG=eng
# OCR_PSM=3
# OCR_TIMEOUT_S=45
# MAX_UPLOAD_BYTES=10485760  (default for the OCR role: 10 MB)

# Supabase Storage (server-only) for /api/v1/internal/process. Unset = only
# the multipart /api/v1/internal/convert path works (local development).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=mdify-pro-files
