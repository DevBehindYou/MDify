{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "frontend",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "backendN-N1",
      "runtimeExecutable": "backendN/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backendN",
        "--host",
        "127.0.0.1",
        "--port",
        "8001",
        "--no-access-log"
      ],
      "port": 8001,
      "env": {
        "BACKEND_ROLE": "normal",
        "BACKEND_INSTANCE": "N1"
      }
    },
    {
