# backendZ — archive pool (ZIP files). Deploy twice (Z1, Z2) from this folder
# with the same code and a different BACKEND_INSTANCE.

BACKEND_ROLE=archive
BACKEND_INSTANCE=Z1

# Must equal BACKEND_SHARED_SECRET on the frontend. Without it every
# internal call is rejected (fail closed).
INTERNAL_SHARED_SECRET=change-me

# Optional
# MAX_UPLOAD_BYTES=15728640  (default for the archive role: 15 MB)
# APP_VERSION=dev

# Archive limits (defaults shown)
# MAX_ARCHIVE_ENTRIES=2000
# MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
# MAX_ENTRY_UNCOMPRESSED_BYTES=15728640
# MAX_ARCHIVE_IMAGE_BYTES=10485760
# MAX_COMPRESSION_RATIO=100
# MAX_ARCHIVE_DEPTH=1
# MAX_NESTED_ARCHIVES=10
# MAX_ARCHIVE_OCR_IMAGES=50
# MAX_ARCHIVE_OUTPUT_BYTES=41943040
# ARCHIVE_TIME_BUDGET_S=100

# Supabase Storage (server-only) for the archive tasks. Unset = only the
# multipart /api/v1/internal/convert path works (no image text recognition).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=mdify-pro-files
