# Copy to .env for local overrides (defaults work out of the box).
# On Render, set these as environment variables in the dashboard.

# Comma-separated list of allowed frontend origins for CORS.
# localhost:3000 / :3001 are always allowed; add the deployed Vercel URL here.
# Example: https://mdify-pro.vercel.app
FRONTEND_URL=

# Max upload size in bytes (default 25 MB). Uncomment to override.
# MAX_FILE_SIZE=26214400

# Per-IP rate limit for the convert endpoint (slowapi syntax).
# RATE_LIMIT_CONVERT=30/minute

# Maximum simultaneous blocking conversions per backend process (default 2).
# MAX_CONCURRENT_CONVERSIONS=2
